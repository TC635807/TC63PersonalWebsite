---
import { site } from '../config/site';
import { directions } from '../data/directions';

interface Props {
  /** 首页「关于我」面板里用：两栏间距更紧 */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const affiliation = [site.school, site.major, site.grade].filter(Boolean).join(' · ');
---

<div class:list={['grid-2', compact && 'grid-2--panel']}>
  <div>
    <h3>{site.name}</h3>
    <p class="mono about-intro__aff">{affiliation}</p>
    <p class="hero__tag" style="font-size: 1.05rem">{site.tagline}</p>
    <p class="lead">{site.description}</p>

    <h3 style="margin-top: var(--ak-space-6)">做法</h3>
    <p style="color: var(--ink-2)">{site.approach}</p>
  </div>

  <div>
    <h3 style="margin-top: 0">三个方向</h3>
    <div class="about-intro__dirs">
      {directions.map((d) => (
        <div>
          <div class="pj__sub">{d.t}</div>
          <p style="margin: 6px 0 0; color: var(--ink-2); font-size: .95rem">{d.d}</p>
        </div>
      ))}
    </div>
  </div>
</div>
