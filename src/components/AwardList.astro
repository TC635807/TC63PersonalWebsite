---
import { awards } from '../data/awards';
import { url } from '../lib/url';

interface Props {
  /** 首页面板里用：行距更紧 */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class:list={['awards', compact && 'awards--compact']}>
  {awards.map((a, i) => (
    <li class="award-row">
      <span class="mono award-row__idx">{pad(i + 1)}</span>
      <div class="award-row__main">
        <span class="award-row__event">{a.event}</span>
        {a.track ? <span class="award-row__track">{a.track}</span> : null}
        {a.works && a.works.length > 0 ? (
          <span class="award-row__works">
            {a.works.map((w) => <a href={url('/projects/' + w.slug + '/')}>{w.label} →</a>)}
          </span>
        ) : null}
      </div>
      <div class="award-row__side">
        <span class="award">{a.prize}</span>
        <span class="mono award-row__year">{a.year}</span>
      </div>
    </li>
  ))}
</ol>
