---
interface Props {
  id?: string;
}
const { id = 'fluid-canvas' } = Astro.props;
---
<div class="fluid-wrap">
  <canvas id={id} aria-hidden="true"></canvas>
</div>

<script>
  import { initFluid } from '../scripts/fluid.js';
  import { url } from '../lib/url';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.getElementById('fluid-canvas');

  if (canvas && !reduce) {
    initFluid({
      canvasSelector: '#fluid-canvas',
      ditheringTexture: url('/fluid/LDR_LLL1_0.png'),
      // 白紫主题：白纸背景 + 紫色色相（0.70–0.82 收在紫段，避免偏品红），关 bloom（白底发光会发灰）
      hueRange: [0.70, 0.82],
      config: {
        BACK_COLOR: { r: 255, g: 255, b: 255 },
        TRANSPARENT: false,
        BLOOM: false,
        SUNRAYS: false,
        // 首页面板是横屏小屏，靠"墨要留得住但更薄"来控制画面重量：衰减 0.6 → 0.9
        DENSITY_DISSIPATION: 1.0,
        // 笔触收小，避免大团色块压过白纸的干净感
        SPLAT_RADIUS: 0.16,
      },
      // 悬停是"搅一下"而不是泼一盆，指针亮度压到 0.55
      pointerColorScale: 0.55,
      ambientIntervalMs: 5000,
      // 开场只铺 6 团半亮度的墨：横屏 HUD 屏上一上来就 10 团满亮度会糊住白纸
      initialSplats: 6,
      initialColorScale: 0.5,
    });
  }
</script>