---
import type { Project } from '../data/projects';
import { url } from '../lib/url';

interface Props {
  project: Project;
  fig?: string | null;
  index?: number;
}
const { project, fig = null, index } = Astro.props;
const badgeClass =
  project.statusKind === 'live'
    ? 'badge badge--live'
    : project.statusKind === 'wip'
      ? 'badge badge--wip'
      : 'badge badge--private';
---
<article class="pj">
  {project.cover ? (
    <figure class="pj__fig pj__fig--photo">
      <img src={url(project.cover.src)} alt={project.cover.alt} loading="lazy" decoding="async" />
      {project.cover.caption ? <figcaption>{project.cover.caption}</figcaption> : null}
    </figure>
  ) : fig ? (
    <div class="pj__fig" set:html={fig} />
  ) : (
    <div class="pj__fig pj__fig--empty"></div>
  )}

  <div class="pj__body">
    <div class="pj__sub">{project.subtitle}</div>
    <div class="pj__head">
      {index ? <span class="mono accent">{String(index).padStart(2, '0')}</span> : null}
      <h3><a href={url('/projects/' + project.slug + '/')}>{project.title}</a></h3>
      <span class="pj__year">{project.year} · {project.role}</span>
    </div>
    <p class="pj__sum">{project.summary}</p>
    <div class="tags">
      {project.tech.slice(0, 6).map((t) => <span class="tag">{t}</span>)}
    </div>
    <div class="pj__foot">
      <span class={badgeClass}>{project.status}</span>
      {project.award ? <span class="award">{project.award}</span> : null}
      <span class="pj__links">
        {project.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
        <a href={url('/projects/' + project.slug + '/')}>详情 →</a>
      </span>
    </div>
  </div>
</article>
