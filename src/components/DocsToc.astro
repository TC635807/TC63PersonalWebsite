---
import type { DocUnit } from '../lib/docs';

interface Props {
  unit: DocUnit;
}

const { unit } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="railbox__head">
  <span class="railbox__k">Contents</span>
  <span class="railbox__n">{pad(unit.count)} 文件</span>
</div>

<nav aria-label="本单元目录" data-toc>
  {unit.toc.map((f, fi) => (
    <div class="toc__file" data-fi={fi}>
      <a href={'#' + f.anchor}>
        <span class="n">{pad(fi + 1)}</span>
        <span>{f.file}</span>
      </a>
      {f.headings.length > 0 ? (
        <ul class="toc__heads">
          {f.headings.map((h, j) => (
            <li>
              <a href={'#' + h.slug} data-depth={h.depth} data-heading-j={j}>{h.text}</a>
            </li>
          ))}
        </ul>
      ) : null}
    </div>
  ))}
</nav>
