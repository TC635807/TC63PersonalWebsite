---
import type { Project } from '../data/projects';
import { url } from '../lib/url';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const badgeClass =
  project.statusKind === 'live'
    ? 'badge badge--live'
    : project.statusKind === 'wip'
      ? 'badge badge--wip'
      : 'badge badge--private';
---
<article class="card">
  <div class="card-head">
    <h3><a href={url('/projects/' + project.slug + '/')}>{project.title}</a></h3>
    <span class="year">{project.year}</span>
  </div>
  <div class="sub">{project.subtitle}</div>
  <p class="summary">{project.summary}</p>
  <div class="chips">
    {project.tech.slice(0, 5).map((t) => <span class="chip">{t}</span>)}
  </div>
  <div class="card-foot">
    <span class={badgeClass}>{project.status}</span>
    <span class="card-links">
      {project.links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
      ))}
    </span>
  </div>
</article>
