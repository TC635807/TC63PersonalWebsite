---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { projects } from '../data/projects';
import { awards } from '../data/awards';
import AwardList from '../components/AwardList.astro';
import AboutIntro from '../components/AboutIntro.astro';

const tech = Array.from(new Set(projects.flatMap((p) => p.tech))).sort((a, b) => a.localeCompare(b, 'zh-Hans-CN'));
const pub = projects.filter((p) => p.statusKind === 'live').length;
const pad = (n: number) => String(n).padStart(2, '0');
const affiliation = [site.school, site.major, site.grade].filter(Boolean).join(' · ');

---

<BaseLayout
  title="关于"
  description={'关于' + site.name + '：' + affiliation + '，做机器人控制、强化学习与 AI 工具链。'}
>
  <section class="sec">
    <div class="sec-head">
      <span class="sec-head__idx">01</span>
      <h1>关于</h1>
      <span class="sec-head__rule"></span>
    </div>
    <AboutIntro />
  </section>

  <section class="sec sec--tight">
    <div class="sec-head">
      <span class="sec-head__idx">02</span>
      <h2>获奖</h2>
      <span class="sec-head__rule"></span>
      <span class="sec-head__more mono">{pad(awards.length)} 项</span>
    </div>
    <AwardList />
  </section>

  <section class="sec sec--tight">
    <div class="sec-head">
      <span class="sec-head__idx">03</span>
      <h2>技术栈</h2>
      <span class="sec-head__rule"></span>
      <span class="sec-head__more mono">{tech.length} 项</span>
    </div>
    <div class="tags">
      {tech.map((t) => <span class="tag">{t}</span>)}
    </div>
  </section>

  <section class="sec sec--tight">
    <div class="sec-head">
      <span class="sec-head__idx">04</span>
      <h2>账号</h2>
      <span class="sec-head__rule"></span>
    </div>
    <div class="grid-2">
      <div>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px">
          {site.socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="me noopener">{s.label} ↗</a></li>
          ))}
          {site.contacts.map((c) => (
            <li class="mono" style="color: var(--ink-2)">
              {c.label}：<span style="user-select: all; color: var(--ink)">{c.value}</span>
            </li>
          ))}
          {site.email ? <li><a href={'mailto:' + site.email}>{site.email}</a></li> : null}
        </ul>
      </div>
      <div>
        <h3 style="margin-top:0">这个站点</h3>
        <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:10px; color: var(--ink-2); font-size: .95rem">
          <li>Astro 构建的纯静态站，输出可放任意托管。</li>
          <li>视觉语言参考 <a href="https://ak-ui.yyj.moe/" target="_blank" rel="noopener">ak-ui</a>：非对称切角几何、颜色即信号、层级优先于装饰。</li>
          <li>首屏流体改编自 <a href="https://github.com/PavelDoGreat/WebGL-Fluid-Simulation" target="_blank" rel="noopener">WebGL-Fluid-Simulation</a>（MIT），改为白底紫色墨感。</li>
          <li>内容集中在 <span class="mono">src/data/projects.ts</span> 与 <span class="mono">src/config/site.ts</span>。</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
