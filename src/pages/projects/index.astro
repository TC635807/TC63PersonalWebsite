---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { projects } from '../../data/projects';

const diagrams = import.meta.glob('../../assets/diagrams/*.svg', {
  eager: true,
  query: '?raw',
  import: 'default',
}) as Record<string, string>;
const figFor = (slug: string) => {
  const key = Object.keys(diagrams).find((k) => k.endsWith('/' + slug + '.svg'));
  return key ? diagrams[key] : null;
};
const pub = projects.filter((p) => p.statusKind === 'live').length;
---
<BaseLayout title="项目" description="全部项目：机器人固件、强化学习策略与 AI 工具链，每个都附结构与流程示意图。">
  <section class="sec">
    <div class="sec-head">
      <span class="sec-head__idx">01</span>
      <h1>全部项目</h1>
      <span class="sec-head__rule"></span>
      <span class="sec-head__more mono">{projects.length} 个 · {pub} 个已开源</span>
    </div>
    <p class="lead">
      每个项目都配了一张自己画的示意图：CAN 总线拓扑、分层回退路径、数据流水线或训练调度流程。
    </p>
    <div class="pj-list" style="margin-top: var(--ak-space-5)">
      {projects.map((p, i) => <ProjectRow project={p} fig={figFor(p.slug)} index={i + 1} />)}
    </div>
  </section>
</BaseLayout>
