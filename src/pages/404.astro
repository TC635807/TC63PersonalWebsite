---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---
<BaseLayout title="页面不存在">
  <section class="sec">
    <span class="tick"></span>
    <p class="eyebrow" style="margin-top: var(--ak-space-3)">ERROR 404</p>
    <h1>这个页面不存在</h1>
    <p class="lead">可能是链接过期了，或者项目还没公开。</p>
    <div class="actions">
      <a class="btn btn--primary" href={url('/')}>回到首页</a>
      <a class="btn" href={url('/projects/')}>查看项目</a>
    </div>
  </section>
</BaseLayout>
